post_install() {
    echo "Create the CUPS queue with:  sudo dcpt230-setup"
    echo "Scanner support: install sane + brscan5 (AUR) and run scanner/setup.sh from the source tree."
}

post_upgrade() {
    post_install
}

post_remove() {
    echo "The CUPS queue (if any) is still configured; remove it with:  lpadmin -x DCP-T230"
}
