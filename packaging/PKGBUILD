# Maintainer: Vitor Hugo Fernandes Oliveira <vitor.oliveira@medicina.uniceplac.edu.br>
#
# This is the file submitted to the AUR as "brother-dcpt230-open".
# The AUR holds its own git repository with the PKGBUILD, the .install file
# and .SRCINFO; keep this copy in sync when releasing a new version.
pkgname=brother-dcpt230-open
pkgver=1.0.1
pkgrel=1
pkgdesc="Open CUPS driver for the Brother DCP-T230 inkjet printer (600 dpi)"
arch=('x86_64' 'aarch64')
url="https://github.com/vituxdxd/brother-dcpt230"
license=('GPL-2.0-or-later')
depends=('cups' 'cups-filters' 'ghostscript')
makedepends=('gcc' 'python')
optdepends=('brscan5: scanner support (AUR)')
options=('!debug')
conflicts=('brother-dcp-t230')
install="$pkgname.install"
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('59edfbb88116fda9e79adb113779b0e867294f781df6904a09624670e8a4bd71')

build() {
    make -C "brother-dcpt230-$pkgver/driver"
}

package() {
    cd "brother-dcpt230-$pkgver"
    install -Dm755 driver/t230_encode \
        "$pkgdir/usr/lib/brother-t230/t230_encode"
    install -Dm755 driver/brother-t230 \
        "$pkgdir/usr/lib/cups/filter/brother-t230"
    install -Dm644 driver/papers.tsv \
        "$pkgdir/usr/share/brother-t230/papers.tsv"
    install -Dm644 driver/ppd/brother-t230.ppd \
        "$pkgdir/usr/share/ppd/Brother/brother-t230.ppd"
    install -Dm755 driver/dcpt230-setup \
        "$pkgdir/usr/bin/dcpt230-setup"
}
